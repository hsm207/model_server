+    -DENABLE_OV_JAX_FRONTEND=OFF ^
+    -DENABLE_OV_IR_FRONTEND=ON ^
+    -DENABLE_TESTS=OFF ^
+    -DENABLE_SAMPLES=OFF ^
+    -DENABLE_PYTHON=ON ^
+    -DENABLE_WHEEL=ON ^
+    -DENABLE_JS=OFF ^
+    -DENABLE_OPENVINO_DEBUG=OFF ^
+    -DTHREADING=TBB ^
+    -DENABLE_PROXY=OFF ^
+    -DENABLE_MULTI=OFF ^
+    -DENABLE_AUTO=OFF ^
+    -DENABLE_AUTO_BATCH=OFF ^
