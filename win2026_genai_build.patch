++++++++      [type.googleapis.com / mediapipe.LLMCalculatorOptions]: {
++++++++          models_path: "C:/Users/mohds/Documents/GitHub/openvino-artifacts/models/gemma-4-12B-it-qat-int4-ov",
++++++++          plugin_config: '{}',
++++++++          dynamic_split_fuse: false,
++++++++          max_num_seqs: 256,
++++++++          max_num_batched_tokens: 8192,
++++++++          cache_size: 0,
++++++++          device: "GPU",
